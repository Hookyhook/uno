# Create a free Redis database at https://console.upstash.com, or use Vercel's
# Storage tab (Upstash Redis) which provisions one and sets these for you.
# KV_REST_API_URL / KV_REST_API_TOKEN are accepted as aliases.
# Leave unset locally to use an in-memory store (dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
